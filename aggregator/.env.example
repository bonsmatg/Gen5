# =====================================================
# JARVIS GEN5 – SECURE FEDERATED AGGREGATOR CONFIG
# =====================================================

# --- Security / Auth ---
# Token that clients must present in Authorization header (Bearer TOKEN)
AGG_TOKEN=changeme-super-secure-token

# Require authentication for API endpoints (1 = enabled)
REQUIRE_AUTH=1

# --- Networking ---
# Aggregator service host/port (internal use)
AGG_HOST=0.0.0.0
AGG_PORT=4000

# IPFS node API URL (used for uploading global models)
IPFS_API=http://ipfs:5001

# --- Database / Cache ---
# PostgreSQL connection URI
POSTGRES_URL=postgresql+asyncpg://fl:fl@postgres:5432/jarvis

# Redis connection URI (for caching pending updates, masks)
REDIS_URL=redis://redis:6379/0

# --- File paths ---
# Directory for logs, stored inside container (mounted volume)
LOG_DIR=/app/logs
# Directory for temporary model files
MODEL_DIR=/app/models

# --- Aggregation Behavior ---
# Maximum number of pending updates before triggering FedAvg
MAX_PENDING=1000
# Weighted FedAvg (1 = weighted by local sample counts)
WEIGHTED_AVG=1
# Enable secure aggregation masking (1 = enabled)
ENABLE_SECURE_AGG=1

# --- IPFS / Blockchain (optional) ---
# Upload global model to IPFS after aggregation (1 = enabled)
ENABLE_IPFS_UPLOAD=1
# Record model CID on-chain (optional; 0 = off)
ENABLE_ONCHAIN_LOG=0

# --- Dashboard / Monitoring ---
# Dashboard API endpoint that receives logs (internal)
DASHBOARD_API=http://dashboard:3000/api/logs

# --- Misc ---
# Enable debug logging
DEBUG=1
