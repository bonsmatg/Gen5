# -------------------------------
# MQTT Broker (Jarvis multi-channel backbone)
# -------------------------------
MQTT_BROKER=mqtt
MQTT_PORT=1883

# -------------------------------
# FastAPI Orchestrator
# -------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# -------------------------------
# Twilio (for SMS/calls)
# -------------------------------
TWILIO_SID=placeholder_twilio_sid
TWILIO_TOKEN=placeholder_twilio_token
TWILIO_FROM=+1000000000   # your Twilio phone number in E.164 format

# -------------------------------
# Firebase Cloud Messaging (Push notifications)
# -------------------------------
FCM_SERVER_KEY=placeholder_firebase_key

# -------------------------------
# Local AI Endpoint (optional LLM for Jarvis)
# -------------------------------
LOCAL_AI_ENDPOINT=http://ai-service:5000
